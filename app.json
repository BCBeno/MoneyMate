{
  "expo": {
    "name": "MoneyMate",
    "slug": "moneymate",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D12",
    "splash": {
      "backgroundColor": "#0B0D12"
    },
    "icon": "./assets/icon.png",
    "android": {
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "package": "com.bcbeno.moneymate",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-local-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow MoneyMate to access Face ID."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3bcbb686-3673-4747-a857-842d0eab11e3"
      }
    }
  }
}